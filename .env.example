# Copy to .env and fill in. Every value has a working default except Slack.

# Slack > Apps > Incoming Webhooks > Add New Webhook to Workspace
SLACK_WEBHOOK_URL=

FRONTEND_URL=http://localhost:3000
KAFKA_BOOTSTRAP=localhost:9092
MONGO_URI=mongodb://localhost:27017
NEO4J_URI=bolt://localhost:7687
NEO4J_PASSWORD=logiq-password
HDFS_URL=hdfs://localhost:8020

# Tuning
SIMILARITY_THRESHOLD=0.90
CORRELATION_DELAY_SEC=8
ALERT_WINDOW_SEC=600
INCIDENT_QUIET_SEC=600
